### WWSHA API requests (VS Code REST Client format)
### Run the API with the "http" profile (dotnet run --launch-profile http), then send the requests
### top to bottom. The hero and incident IDs are captured from earlier responses, so no editing is needed.

@baseUrl = http://localhost:5178

### Health
GET {{baseUrl}}/api/health

### Register a hero (201). If an incident is waiting, the hero is dispatched to it right away.
# @name registerHero
POST {{baseUrl}}/api/heroes
Content-Type: application/json

{
  "name": "Captain Inconvenient",
  "superpower": "Teleports people one to three feet to the left",
  "reputation": 1
}

@heroId = {{registerHero.response.body.$.id}}

### List available heroes
GET {{baseUrl}}/api/heroes?available=true

### File an incident (201). It is auto-assigned to the oldest free hero, or left Opened.
# @name fileIncident
POST {{baseUrl}}/api/incidents
Content-Type: application/json

{
  "city": "Redmond",
  "occurredAt": "2026-11-15T12:00:00",
  "description": "Rowdy sportsball fans brawling in a bar",
  "category": "DrunkenBarFight"
}

@incidentId = {{fileIncident.response.body.$.id}}

### List in-progress incidents in Redmond
GET {{baseUrl}}/api/incidents?status=InProgress&city=Redmond

### File a damage report (201). Allowed while the incident is Opened or InProgress.
POST {{baseUrl}}/api/incidents/{{incidentId}}/reports
Content-Type: application/json

{
  "city": "Redmond",
  "description": "Table legs busted, glasses broken",
  "severity": "Minor",
  "cost": 350,
  "injury": 0
}

### Close the incident (200). Assesses heroes, frees them, and dispatches waiting incidents.
POST {{baseUrl}}/api/incidents/{{incidentId}}/close

### Assessments for the hero
GET {{baseUrl}}/api/heroes/{{heroId}}/assessments
